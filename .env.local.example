# ─────────────────────────────────────────────────────────────
# Firebase environment variables for lib/firebase.js
#
# 1. Copy this file to `.env.local`  (cp .env.local.example .env.local)
# 2. Replace every placeholder below with your real values.
# 3. NEVER commit `.env.local` — it is listed in .gitignore.
# 4. Add the same variables in Vercel → Project Settings →
#    Environment Variables before deploying.
#
# Where to find the values:
#   Firebase console → Project settings (gear icon) → General →
#   "Your apps" → select your Web app → "SDK setup and configuration"
#   → choose "Config". Copy each value from the firebaseConfig object.
# ─────────────────────────────────────────────────────────────

# Web API key for your Firebase project (firebaseConfig.apiKey)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here

# Domain used by Firebase Authentication (firebaseConfig.authDomain)
# Usually: your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Your Firebase project ID (firebaseConfig.projectId)
# Also shown under Project settings → General → Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Cloud Storage bucket for uploaded images (firebaseConfig.storageBucket)
# Usually: your-project-id.appspot.com (or your-project-id.firebasestorage.app)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Cloud Messaging sender ID (firebaseConfig.messagingSenderId)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# Web app ID (firebaseConfig.appId)
# Also under Project settings → General → Your apps
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# OPTIONAL — Google Analytics measurement ID (firebaseConfig.measurementId).
# Only present if Analytics is enabled for the project.
# NOTE: lib/firebase.js does not read this variable yet; it is listed here
# only so it is documented if you add Analytics later.
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
